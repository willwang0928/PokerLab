# Backend
POKERLAB_CORS_ORIGINS=http://localhost:5173
POKERLAB_HOST=127.0.0.1
POKERLAB_PORT=8000
# Allow clients to pass a "seed" when creating a game (tests and debugging only)
POKERLAB_ALLOW_SEED=
# Where learning progress is stored (SQLite). Default: ./data/pokerlab.sqlite3 relative to
# the backend's working directory. POKERLAB_DB overrides the full path.
POKERLAB_DATA_DIR=
POKERLAB_DB=

# Frontend (Vite) — leave empty to use the dev proxy (/api -> backend)
VITE_API_BASE_URL=
